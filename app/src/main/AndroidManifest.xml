<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Nothing in the shipped build makes a network call: the telemetry stack
         (Firebase Analytics + Crashlytics) is the only thing that ever needed
         this, and it is compiled out while telemetryEnabled = false in
         app/build.gradle.kts. Play in-app review/update reach the Play Store
         app over IPC, and voice typing runs in the recognizer's own process,
         so neither needs it here. A keyboard advertising "Full network access"
         it never uses is a trust cost, so keep this off.
         RE-ENABLE THIS LINE if telemetry is ever turned back on
         (telemetryEnabled = true / TelemetryFeature.ENABLED): Firebase
         cannot upload anything without it. -->
    <!-- <uses-permission android:name="android.permission.INTERNET" /> -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_TOPICS"
        tools:node="remove" />

    <!-- Package-visibility (API 30+): lets SpeechRecognizer.isRecognitionAvailable()
         and intent resolution see Google's (or another) speech recognition
         service on-device. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".AddiyonApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AddiyonKeyboard"
        tools:targetApi="31" >

        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_personalization_signals"
            android:value="false" />

        <!-- android:label is what Settings > Languages & input and the IME
             picker show. Without it the name falls back to the application
             label implicitly; naming it here makes that deliberate and gives
             the framework a string it can localize (values-am). -->
        <service
            android:name=".AddiyonKeyboardService"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AddiyonKeyboard.Splash"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Opened directly from the keyboard toolbar so their screens are the
             first frame drawn (no MainActivity home flash). Not exported. -->
        <activity
            android:name=".ThemesActivity"
            android:exported="false"
            android:theme="@style/Theme.AddiyonKeyboard" />
        <activity
            android:name=".ManualActivity"
            android:exported="false"
            android:theme="@style/Theme.AddiyonKeyboard"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".FeedbackActivity"
            android:exported="false"
            android:theme="@style/Theme.AddiyonKeyboard" />
        <!-- Transparent, no-UI: only requests RECORD_AUDIO on the service's
             behalf (an InputMethodService can't call requestPermissions()
             itself) and finishes immediately. See VoicePermissionActivity. -->
        <activity
            android:name=".VoicePermissionActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>

</manifest>
